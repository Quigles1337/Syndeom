  "imports": ["Mathlib.Basic.Real.Basic", "Mathlib.Tactic.Linarith", "Mathlib.Tactic.Ring"],
  "binders": "(x : ℝ)",
  "claim": "x ^ 2 + 1 ≥ 2 * x",
  "styles": [
    {
      "id": "expand_square",
      "steps": [
        {
          "text": "Expanding the square, $(x - 1)^2 = x^2 - 2x + 1$.",
          "fragment": ["have h1 : (x - 1) ^ 2 = x ^ 2 - 2 * x + 1 := by ring"]
        },
        {
          "text": "A square is non-negative, so $x^2 - 2x + 1 = (x - 1)^2 \\ge 0$.",
          "fragment": ["have h2 : x ^ 2 - 2 * x + 1 ≥ 0 := by nlinarith [sq_nonneg (x - 1)]"]
        },
        {
          "text": "Adding $2x$ to both sides gives $x^2 + 1 \\ge 2x$.",
          "fragment": ["linarith"]
        }
      ],
