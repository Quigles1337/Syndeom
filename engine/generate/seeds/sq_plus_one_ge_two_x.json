  "title": "A square plus one is at least twice the number",
  "statement": "For every real number $x$, $x^2 + 1 \\ge 2x$.",
  "truth": {
    "value": true,
    "method": "lean-kernel",
    "reference": "lean/Syndeom/Seeds/SqPlusOneGeTwoX.lean:syndeom_seed_sq_plus_one_ge_two_x"
