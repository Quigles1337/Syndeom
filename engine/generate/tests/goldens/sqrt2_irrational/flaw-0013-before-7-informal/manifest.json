      },
      {
        "class": "FLAW-0013",
        "dials": {
          "count": 7,
          "inserted": "A third derivation: writing $p^2 = p \\cdot p$, the residue of a product modulo $2$ is the product of the residues, so if $p \\bmod 2 = 1$ then $p \\cdot p \\bmod 2 = 1 \\cdot 1 = 1$, which is impossible when $2 \\mid p^2$; hence $p$ is even.",
          "kind": "re-derivation",
          "kinds": [
            "restated-definition",
            "re-derivation"
          ],
          "paragraph": 7,
          "placement": "before",
