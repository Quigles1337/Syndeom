      {
        "class": "FLAW-0013",
        "dials": {
          "count": 7,
          "inserted": "We check once more that if $2 \\mid p^2$ then $2 \\mid p$: the residue of $p^2$ modulo $2$ is the residue of $(p \\bmod 2)^2$, so if $p \\bmod 2 = 1$ then $p^2 \\bmod 2 = 1$ and $2 \\nmid p^2$; hence $p \\bmod 2 = 0$.",
          "kind": "re-derivation",
