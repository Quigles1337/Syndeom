      },
      {
        "class": "FLAW-0013",
        "dials": {
          "count": 7,
          "inserted": "Recall that a rational number is a quotient $p/q$ of integers with $q \\ne 0$, that every positive rational number has a representation in lowest terms with $p$ and $q$ natural numbers, and that $\\gcd(p, q)$, the greatest common divisor, is the largest natural number dividing both $p$ and $q$; in particular it divides both.",
          "kind": "restated-definition",
          "kinds": [
            "restated-definition",
            "re-derivation"
          ],
          "paragraph": 2,
          "placement": "before",
