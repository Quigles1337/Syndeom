      {
        "class": "FLAW-0013",
        "dials": {
          "count": 7,
          "inserted": "Recall the definition of divisibility: for natural numbers $a$ and $b$, $a \\mid b$ means that $b = ac$ for some natural number $c$; in particular $2 \\mid b$ means $b = 2c$ for some $c$, and such a $b$ is called even.",
          "kind": "restated-definition",
          "kinds": [
            "restated-definition",
            "re-derivation"
          ],
          "paragraph": 1,
          "placement": "before",
