import Mathlib.Basic.Real.Basic
import Mathlib.Tactic.Linarith

theorem syndeom_s2_grammar_ineq_chain (x y : ℝ) : 12 * x * y + 14 * x + 12 * y + 6 * |x + y| ≤ 40 * x ^ 2 + 38 * y ^ 2 + 2 * x + 38 + 6 * |x| + 6 * |y| := by
  calc 12 * x * y + 14 * x + 12 * y + 6 * |x + y| ≤ x ^ 2 + 10 * x * y + y ^ 2 + 14 * x + 12 * y + 6 * |x + y| := by linarith [sq_nonneg (x - y)]
    _ ≤ 2 * x ^ 2 + 10 * x * y + y ^ 2 + 12 * x + 12 * y + 1 + 6 * |x + y| := by linarith [two_mul_le_add_sq x 1]
    _ ≤ 3 * x ^ 2 + 10 * x * y + y ^ 2 + 14 * x + 12 * y + 2 + 6 * |x + y| := by linarith [sq_nonneg (x + 1)]
    _ ≤ 4 * x ^ 2 + 12 * x * y + 2 * y ^ 2 + 14 * x + 12 * y + 2 + 6 * |x + y| := by linarith [sq_nonneg (x + y)]
    _ ≤ 4 * x ^ 2 + 12 * x * y + 3 * y ^ 2 + 14 * x + 10 * y + 3 + 6 * |x + y| := by linarith [two_mul_le_add_sq y 1]
    _ ≤ 4 * x ^ 2 + 12 * x * y + 4 * y ^ 2 + 14 * x + 12 * y + 4 + 6 * |x + y| := by linarith [sq_nonneg (y + 1)]
    _ ≤ 5 * x ^ 2 + 12 * x * y + 4 * y ^ 2 + 12 * x + 12 * y + 5 + 6 * |x + y| := by linarith [sq_nonneg (x - 1)]
    _ ≤ 5 * x ^ 2 + 12 * x * y + 4 * y ^ 2 + 12 * x + 12 * y + 5 + |x| + |y| + 5 * |x + y| := by linarith [abs_add_le x y]
    _ ≤ 6 * x ^ 2 + 10 * x * y + 5 * y ^ 2 + 12 * x + 12 * y + 5 + |x| + |y| + 5 * |x + y| := by linarith [two_mul_le_add_sq x y]
    _ ≤ 6 * x ^ 2 + 10 * x * y + 6 * y ^ 2 + 12 * x + 10 * y + 6 + |x| + |y| + 5 * |x + y| := by linarith [sq_nonneg (y - 1)]
    _ ≤ 7 * x ^ 2 + 8 * x * y + 7 * y ^ 2 + 12 * x + 10 * y + 6 + |x| + |y| + 5 * |x + y| := by linarith [sq_nonneg (x - y)]
    _ ≤ 8 * x ^ 2 + 8 * x * y + 7 * y ^ 2 + 10 * x + 10 * y + 7 + |x| + |y| + 5 * |x + y| := by linarith [two_mul_le_add_sq x 1]
    _ ≤ 9 * x ^ 2 + 8 * x * y + 7 * y ^ 2 + 12 * x + 10 * y + 8 + |x| + |y| + 5 * |x + y| := by linarith [sq_nonneg (x + 1)]
    _ ≤ 10 * x ^ 2 + 10 * x * y + 8 * y ^ 2 + 12 * x + 10 * y + 8 + |x| + |y| + 5 * |x + y| := by linarith [sq_nonneg (x + y)]
    _ ≤ 10 * x ^ 2 + 10 * x * y + 9 * y ^ 2 + 12 * x + 8 * y + 9 + |x| + |y| + 5 * |x + y| := by linarith [two_mul_le_add_sq y 1]
    _ ≤ 10 * x ^ 2 + 10 * x * y + 10 * y ^ 2 + 12 * x + 10 * y + 10 + |x| + |y| + 5 * |x + y| := by linarith [sq_nonneg (y + 1)]
    _ ≤ 11 * x ^ 2 + 10 * x * y + 10 * y ^ 2 + 10 * x + 10 * y + 11 + |x| + |y| + 5 * |x + y| := by linarith [sq_nonneg (x - 1)]
    _ ≤ 11 * x ^ 2 + 10 * x * y + 10 * y ^ 2 + 10 * x + 10 * y + 11 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [abs_add_le x y]
    _ ≤ 12 * x ^ 2 + 8 * x * y + 11 * y ^ 2 + 10 * x + 10 * y + 11 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [two_mul_le_add_sq x y]
    _ ≤ 12 * x ^ 2 + 8 * x * y + 12 * y ^ 2 + 10 * x + 8 * y + 12 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [sq_nonneg (y - 1)]
    _ ≤ 13 * x ^ 2 + 6 * x * y + 13 * y ^ 2 + 10 * x + 8 * y + 12 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [sq_nonneg (x - y)]
    _ ≤ 14 * x ^ 2 + 6 * x * y + 13 * y ^ 2 + 8 * x + 8 * y + 13 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [two_mul_le_add_sq x 1]
    _ ≤ 15 * x ^ 2 + 6 * x * y + 13 * y ^ 2 + 10 * x + 8 * y + 14 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [sq_nonneg (x + 1)]
    _ ≤ 16 * x ^ 2 + 8 * x * y + 14 * y ^ 2 + 10 * x + 8 * y + 14 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [sq_nonneg (x + y)]
    _ ≤ 16 * x ^ 2 + 8 * x * y + 15 * y ^ 2 + 10 * x + 6 * y + 15 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [two_mul_le_add_sq y 1]
    _ ≤ 16 * x ^ 2 + 8 * x * y + 16 * y ^ 2 + 10 * x + 8 * y + 16 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [sq_nonneg (y + 1)]
    _ ≤ 17 * x ^ 2 + 8 * x * y + 16 * y ^ 2 + 8 * x + 8 * y + 17 + 2 * |x| + 2 * |y| + 4 * |x + y| := by linarith [sq_nonneg (x - 1)]
    _ ≤ 17 * x ^ 2 + 8 * x * y + 16 * y ^ 2 + 8 * x + 8 * y + 17 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [abs_add_le x y]
    _ ≤ 18 * x ^ 2 + 6 * x * y + 17 * y ^ 2 + 8 * x + 8 * y + 17 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [two_mul_le_add_sq x y]
    _ ≤ 18 * x ^ 2 + 6 * x * y + 18 * y ^ 2 + 8 * x + 6 * y + 18 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [sq_nonneg (y - 1)]
    _ ≤ 19 * x ^ 2 + 4 * x * y + 19 * y ^ 2 + 8 * x + 6 * y + 18 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [sq_nonneg (x - y)]
    _ ≤ 20 * x ^ 2 + 4 * x * y + 19 * y ^ 2 + 6 * x + 6 * y + 19 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [two_mul_le_add_sq x 1]
    _ ≤ 21 * x ^ 2 + 4 * x * y + 19 * y ^ 2 + 8 * x + 6 * y + 20 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [sq_nonneg (x + 1)]
    _ ≤ 22 * x ^ 2 + 6 * x * y + 20 * y ^ 2 + 8 * x + 6 * y + 20 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [sq_nonneg (x + y)]
    _ ≤ 22 * x ^ 2 + 6 * x * y + 21 * y ^ 2 + 8 * x + 4 * y + 21 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [two_mul_le_add_sq y 1]
    _ ≤ 22 * x ^ 2 + 6 * x * y + 22 * y ^ 2 + 8 * x + 6 * y + 22 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [sq_nonneg (y + 1)]
    _ ≤ 23 * x ^ 2 + 6 * x * y + 22 * y ^ 2 + 6 * x + 6 * y + 23 + 3 * |x| + 3 * |y| + 3 * |x + y| := by linarith [sq_nonneg (x - 1)]
    _ ≤ 23 * x ^ 2 + 6 * x * y + 22 * y ^ 2 + 6 * x + 6 * y + 23 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [abs_add_le x y]
    _ ≤ 24 * x ^ 2 + 4 * x * y + 23 * y ^ 2 + 6 * x + 6 * y + 23 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [two_mul_le_add_sq x y]
    _ ≤ 24 * x ^ 2 + 4 * x * y + 24 * y ^ 2 + 6 * x + 4 * y + 24 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [sq_nonneg (y - 1)]
    _ ≤ 25 * x ^ 2 + 2 * x * y + 25 * y ^ 2 + 6 * x + 4 * y + 24 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [sq_nonneg (x - y)]
    _ ≤ 26 * x ^ 2 + 2 * x * y + 25 * y ^ 2 + 4 * x + 4 * y + 25 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [two_mul_le_add_sq x 1]
    _ ≤ 27 * x ^ 2 + 2 * x * y + 25 * y ^ 2 + 6 * x + 4 * y + 26 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [sq_nonneg (x + 1)]
    _ ≤ 28 * x ^ 2 + 4 * x * y + 26 * y ^ 2 + 6 * x + 4 * y + 26 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [sq_nonneg (x + y)]
    _ ≤ 28 * x ^ 2 + 4 * x * y + 27 * y ^ 2 + 6 * x + 2 * y + 27 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [two_mul_le_add_sq y 1]
    _ ≤ 28 * x ^ 2 + 4 * x * y + 28 * y ^ 2 + 6 * x + 4 * y + 28 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [sq_nonneg (y + 1)]
    _ ≤ 29 * x ^ 2 + 4 * x * y + 28 * y ^ 2 + 4 * x + 4 * y + 29 + 4 * |x| + 4 * |y| + 2 * |x + y| := by linarith [sq_nonneg (x - 1)]
    _ ≤ 29 * x ^ 2 + 4 * x * y + 28 * y ^ 2 + 4 * x + 4 * y + 29 + 5 * |x| + 5 * |y| + |x + y| := by linarith [abs_add_le x y]
    _ ≤ 30 * x ^ 2 + 2 * x * y + 29 * y ^ 2 + 4 * x + 4 * y + 29 + 5 * |x| + 5 * |y| + |x + y| := by linarith [two_mul_le_add_sq x y]
    _ ≤ 30 * x ^ 2 + 2 * x * y + 30 * y ^ 2 + 4 * x + 2 * y + 30 + 5 * |x| + 5 * |y| + |x + y| := by linarith [sq_nonneg (y - 1)]
    _ ≤ 31 * x ^ 2 + 31 * y ^ 2 + 4 * x + 2 * y + 30 + 5 * |x| + 5 * |y| + |x + y| := by linarith [sq_nonneg (x - y)]
    _ ≤ 32 * x ^ 2 + 31 * y ^ 2 + 2 * x + 2 * y + 31 + 5 * |x| + 5 * |y| + |x + y| := by linarith [two_mul_le_add_sq x 1]
    _ ≤ 33 * x ^ 2 + 31 * y ^ 2 + 4 * x + 2 * y + 32 + 5 * |x| + 5 * |y| + |x + y| := by linarith [sq_nonneg (x + 1)]
    _ ≤ 34 * x ^ 2 + 2 * x * y + 32 * y ^ 2 + 4 * x + 2 * y + 32 + 5 * |x| + 5 * |y| + |x + y| := by linarith [sq_nonneg (x + y)]
    _ ≤ 34 * x ^ 2 + 2 * x * y + 33 * y ^ 2 + 4 * x + 33 + 5 * |x| + 5 * |y| + |x + y| := by linarith [two_mul_le_add_sq y 1]
    _ ≤ 34 * x ^ 2 + 2 * x * y + 34 * y ^ 2 + 4 * x + 2 * y + 34 + 5 * |x| + 5 * |y| + |x + y| := by linarith [sq_nonneg (y + 1)]
    _ ≤ 35 * x ^ 2 + 2 * x * y + 34 * y ^ 2 + 2 * x + 2 * y + 35 + 5 * |x| + 5 * |y| + |x + y| := by linarith [sq_nonneg (x - 1)]
    _ ≤ 35 * x ^ 2 + 2 * x * y + 34 * y ^ 2 + 2 * x + 2 * y + 35 + 6 * |x| + 6 * |y| := by linarith [abs_add_le x y]
    _ ≤ 36 * x ^ 2 + 35 * y ^ 2 + 2 * x + 2 * y + 35 + 6 * |x| + 6 * |y| := by linarith [two_mul_le_add_sq x y]
    _ ≤ 36 * x ^ 2 + 36 * y ^ 2 + 2 * x + 36 + 6 * |x| + 6 * |y| := by linarith [sq_nonneg (y - 1)]
    _ ≤ 37 * x ^ 2 - 2 * x * y + 37 * y ^ 2 + 2 * x + 36 + 6 * |x| + 6 * |y| := by linarith [sq_nonneg (x - y)]
    _ ≤ 38 * x ^ 2 - 2 * x * y + 37 * y ^ 2 + 37 + 6 * |x| + 6 * |y| := by linarith [two_mul_le_add_sq x 1]
    _ ≤ 39 * x ^ 2 - 2 * x * y + 37 * y ^ 2 + 2 * x + 38 + 6 * |x| + 6 * |y| := by linarith [sq_nonneg (x + 1)]
    _ ≤ 40 * x ^ 2 + 38 * y ^ 2 + 2 * x + 38 + 6 * |x| + 6 * |y| := by linarith [sq_nonneg (x + y)]

#print axioms syndeom_s2_grammar_ineq_chain
